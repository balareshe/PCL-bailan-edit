<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupLink"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15,0,0" Title="节点">
                <StackPanel Margin="25,40,25,20">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称" Opacity="0.55" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="到期时间" Opacity="0.55" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="延迟" Opacity="0.55" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel x:Name="PanNodes" />
                    <TextBlock x:Name="LabNodeNote" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                               Text="默认使用上面未过期的节点，延迟每 10 秒刷新一次。可在「高级设置 → 自定义节点」里填写自己的节点地址，填写后将只使用你填写的地址。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardArgument" Margin="0,15" Title="连接选项">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="模式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="0" x:Name="ComboLatencyMode" Grid.ColumnSpan="2" local:SettingService.Key="LinkLatencyMode" Grid.Column="1">
                            <local:MyComboBoxItem Content="优先直连" IsSelected="True" ToolTip="尽量不进行中转，而是 P2P 直连。" />
                            <local:MyComboBoxItem Content="优先低延迟" ToolTip="如果使用中转节点能降低延迟，就不进行直连。&#xa;不过，这会增加社区节点的负载……" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="高级设置" IsSwapped="True" CanSwap="True">
                <Grid Margin="25,40,25,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义节点" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextCustomPeer" local:SettingService.Key="LinkCustomPeer" Grid.Column="1" MaxHeight="28" HintText="udp://节点地址:11010" 
                        ToolTip="本修改版没有内置任何公共中继节点，必须在这里填写才能联机。&#xa;&#xa;格式：udp://地址:端口 或 tcp://地址:端口&#xa;多个节点用英文逗号分隔。&#xa;&#xa;房主与所有加入者必须填写至少一个相同的节点，才能互相连上。&#xa;节点地址请向房主索取，或自行搭建（见下方按钮）。&#xa;&#xa;注意：如果节点只开放 UDP，就必须写 udp://，写 tcp:// 会连不上。" />
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <local:MyButton MinWidth="140" Padding="13,5" Margin="0,0,20,0" HorizontalAlignment="Left"
                            Text="自建共享节点" ColorType="Highlight"
                            ToolTip="如果你有带公网 IP 的服务器，可以自己跑一个 EasyTier 共享节点。&#xa;在服务器上执行 easytier-core --network-name 名字 --network-secret 密码 即可，&#xa;默认监听 TCP/UDP 11010 端口。&#xa;&#xa;注意：不要在跑其他服务的机器上开，共享节点会为任意网络转发流量。" 
                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://github.com/EasyTier/EasyTier" />
                        <local:MyButton MinWidth="140" Padding="13,5" Margin="0,0,20,0" HorizontalAlignment="Left"
                            Text="EasyTier 官网"
                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://easytier.cn" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
